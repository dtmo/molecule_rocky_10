text

keyboard --xlayouts=${guest_keyboard_layout}

lang ${guest_locale}

cdrom
repo --name=baseos --mirrorlist=https://mirrors.rockylinux.org/mirrorlist?arch=$basearch&repo=BaseOS-$releasever$rltype
repo --name=appstream --mirrorlist=https://mirrors.rockylinux.org/mirrorlist?arch=$basearch&repo=AppStream-$releasever$rltype
repo --name=extras --mirrorlist=https://mirrors.rockylinux.org/mirrorlist?arch=$basearch&repo=extras-$releasever$rltype

rootpw --iscrypted --lock ${bcrypt(password)}

timezone ${guest_timezone} --utc

autopart --nolvm

clearpart --all --initlabel

# Disable predictable network interface names
# https://systemd.io/PREDICTABLE_INTERFACE_NAMES/#i-dont-like-this-how-do-i-disable-this
bootloader --append="net.ifnames=0"

%addon com_redhat_kdump --disable
%end

%packages
@^minimal-environment
cloud-init
cloud-utils-growpart
policycoreutils-python-utils
qemu-guest-agent

# Remove unnecessary firmware
-aic94xx-firmware
-atmel-firmware
-b43-openfwwf
-bfa-firmware
-ipw2100-firmware
-ipw2200-firmware
-ivtv-firmware
-iwl*-firmware
-libertas-usb8388-firmware
-ql*-firmware
-rt61pci-firmware
-rt73usb-firmware
-xorg-x11-drv-ati-firmware
-zd1211-firmware
-cockpit
-quota
-alsa-*
-fprintd-pam
-intltool
-microcode_ctl
%end

eula --agreed

reboot --eject

%post --erroronfail
cat <<'EOF' > /etc/cloud/cloud.cfg.d/datasources.cfg
datasource_list: ["NoCloud", "None"]
datasource:
  None:
    metadata:
      local-hostname: "localhost.localdomain"
    userdata_raw: |
      #cloud-config
      ssh_pwauth: true
      user:
        lock_passwd: false
        passwd: ${bcrypt("password")}
        shell: /bin/bash
EOF
%end
